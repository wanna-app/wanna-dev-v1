{
  "expo": {
    "name": "Wanna",
    "slug": "wanna",
    "scheme": "wanna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "notification": {
      "iosDisplayInForeground": true,
      "androidMode": "default",
      "androidCollapsedTitle": "Wanna"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wanna.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Wanna uses the camera so you can take a verification selfie and capture profile photos.",
        "NSPhotoLibraryUsageDescription": "Wanna needs access to your photo library so you can pick profile photos.",
        "NSLocationWhenInUseUsageDescription": "Wanna uses your location to show activities near you and to compute distance to other users."
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.wanna.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#8C52FF",
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f758a37f-b306-4bb5-9e06-ad6dee438066"
      }
    },
    "owner": "wanna-dev"
  }
}
