// Cloudflare Workers Static Assets config for the email-notifications page.
//
// Cloudflare's modern unified Workers+Pages flow auto-runs
// `npx wrangler deploy` against the repo when connected via Git.
// Without this file, wrangler can't tell where the static HTML lives
// and the deploy step fails with:
//   "Could not detect a directory containing static files…"
//
// `assets.directory` is relative to the Cloudflare project's
// configured **root directory** (set in the dashboard under
// Settings → Build → Root directory). The full plan is:
//   - Root directory  = "web/notifications"  (set in Cloudflare dashboard)
//   - assets.directory = "./"                (this file's directory)
// → wrangler picks up everything in web/notifications and serves it.
//
// `name` becomes the *.workers.dev subdomain and the project name in
// Cloudflare. The user-facing URL (notifications.joinwannaapp.com)
// is added separately as a Custom Domain on the Worker.
{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "wanna-notifications",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./"
  }
}
